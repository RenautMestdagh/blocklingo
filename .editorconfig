root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4
tab_width = 4

[*.{yml,yaml,md}]
indent_style = space
indent_size = 2

[{package.json,package-lock.json,composer.json}]
indent_style = space
indent_size = 2
