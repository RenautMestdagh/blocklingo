{
	"name": "blocklingo",
	"version": "0.3.3",
	"private": true,
	"description": "Multilingual WordPress, block by block.",
	"license": "GPL-2.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RenautMestdagh/blocklingo.git"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "wp-scripts build --webpack-src-dir=src --output-path=build",
		"start": "wp-scripts start --webpack-src-dir=src --output-path=build",
		"lint": "npm run lint:js && npm run lint:css",
		"lint:js": "wp-scripts lint-js src assets bin webpack.config.js",
		"lint:css": "wp-scripts lint-style \"src/**/*.scss\" \"assets/**/*.css\"",
		"format": "wp-scripts format src assets",
		"plugin-zip": "wp-scripts plugin-zip",
		"test": "wp-scripts test-unit-js",
		"check:version": "node bin/check-version.mjs"
	},
	"devDependencies": {
		"@wordpress/api-fetch": "^8.1.0",
		"@wordpress/block-editor": "^20.0.0",
		"@wordpress/blocks": "^17.1.0",
		"@wordpress/components": "^44.0.0",
		"@wordpress/compose": "^9.1.0",
		"@wordpress/core-data": "^9.1.0",
		"@wordpress/data": "^11.1.0",
		"@wordpress/editor": "^16.1.0",
		"@wordpress/element": "^10.1.0",
		"@wordpress/hooks": "^5.1.0",
		"@wordpress/i18n": "^7.1.0",
		"@wordpress/plugins": "^8.1.0",
		"@wordpress/rich-text": "^8.1.0",
		"@wordpress/scripts": "^37.1.0",
		"@wordpress/server-side-render": "^7.1.0",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	},
	"files": [
		"blocklingo.php",
		"uninstall.php",
		"readme.txt",
		"includes",
		"assets",
		"build",
		"languages"
	],
	"overrides": {
		"katex": "^0.19.1",
		"markdownlint-cli": "^0.50.0",
		"minimatch@10": "^11.0.5",
		"serialize-javascript": "^7.1.4"
	}
}
